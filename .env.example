# Copia questo file in ".env" (stessa cartella) e compila i valori reali.
# ".env" non va mai condiviso/committato: contiene credenziali.

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ainima

# Chiave API Gemini per la pipeline LLM (Prompt 1-4: intervistatrice EQ,
# rubric-scorer, estrattori profilo self/ideal, judge narrativo).
# Mai committare la chiave reale — solo qui come placeholder.
GEMINI_API_KEY=AIza...

# Firma dei token di sessione JWT (emessi alla verifica OTP, v. CLAUDE.md).
# Genera un valore locale con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=changeme...

# Servizio email transazionale per l'invio dei codici OTP (RF-02).
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev
