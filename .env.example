# Copia questo file in ".env" (stessa cartella) e compila i valori reali.
# ".env" non va mai condiviso/committato: contiene credenziali.

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ainima

# Chiave API Gemini per la pipeline LLM (Prompt 1-4: intervistatrice EQ,
# rubric-scorer, estrattori profilo self/ideal, judge narrativo).
# Mai committare la chiave reale — solo qui come placeholder.
GEMINI_API_KEY=AIza...

# Firma dei token di sessione JWT (emessi alla verifica OTP, v. CLAUDE.md).
# Genera un valore locale con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=changeme...

# Servizio email transazionale per l'invio dei codici OTP (RF-02).
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev

# Solo per scripts/seed_render_from_local.py (migrazione one-shot dal
# Postgres locale al DB di collaudo su Render + upload foto su R2) — non
# usate dall'app backend in esecuzione, che continua a leggere PGHOST/ecc.
DATABASE_URL=postgres://user:password@host:5432/dbname
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=ainima-photos
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
